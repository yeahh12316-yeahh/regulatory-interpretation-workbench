# 外规解读智能体工作台配置模板
# 仅填写变量名和示例，不要提交真实密钥。

APP_ENV=development
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

# PostgreSQL
DATABASE_URL=postgresql+psycopg://regagent:change-me@postgres:5432/regagent
POSTGRES_DB=regagent
POSTGRES_USER=regagent
POSTGRES_PASSWORD=change-me

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
WORKER_CONCURRENCY=2

# S3-compatible object storage; local development uses MinIO.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=regulatory-documents
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_USE_TLS=false

# Model Provider Adapter; keep provider-specific logic out of S1-S4.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_JSON_MODE=true

# Feature gates
ENABLE_S5=false
ENABLE_OCR_FALLBACK=true

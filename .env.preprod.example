APP_ENV=staging
WEB_PORT=8080
API_PORT=8000
PROMETHEUS_PORT=9090

# Replace change-me values locally. Never commit the real file.
JWT_SECRET=replace-with-a-random-32-byte-secret
POSTGRES_DB=regagent
POSTGRES_USER=regagent
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql+psycopg://regagent:replace-with-a-long-database-password@postgres:5432/regagent
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
DATA_DIR=/data/regulatory-workbench
WORKFLOW_EXECUTION_MODE=celery
WORKFLOW_ALLOW_INLINE_FALLBACK=false
REDIS_READINESS_REQUIRED=true
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
WORKER_CONCURRENCY=2

# Deloitte Nova OpenAI-compatible endpoint.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://nova.deloitte.com.cn/del/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=DeepSeek-V4-Flash
LLM_REVIEWER_REQUIRED=false

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
